# GITutor — Environment Variables Example
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# This file contains only placeholder/example values — no real credentials.

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=GITutor
APP_ENV=development
APP_PORT=3000
APP_SECRET_KEY=your_secret_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=your_database_url_here
DATABASE_NAME=gitutor_db
DATABASE_USER=your_database_user_here
DATABASE_PASSWORD=your_database_password_here

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=7d

# ─── GitHub Integration ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ─── AI / LLM (Optional — for AI Micro-Tutor features) ──────────────────────
AI_API_KEY=your_ai_api_key_here
AI_API_BASE_URL=your_ai_api_base_url_here
AI_MODEL=your_model_name_here
